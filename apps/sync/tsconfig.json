{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/http",
          "effect/http-api",
          "effect/persistence",
          "effect/sql",
          "effect/encoding"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
