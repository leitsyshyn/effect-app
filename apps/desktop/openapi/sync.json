                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "link"
        ],
        "operationId": "link.link",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "LinkInfo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkInfo"
                }
              }
            }
          },
          "400": {
