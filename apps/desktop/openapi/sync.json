            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "localPath": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "localPath"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "tags": [
