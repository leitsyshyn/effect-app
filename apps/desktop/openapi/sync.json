  "components": {
    "schemas": {
      "effect_HttpApiError_UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "IssueNotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "IssueNotFound"
            ]
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "id"
        ],
        "additionalProperties": false
      },
      "IssueItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "EditEdit",
              "InitialDiff",
              "KindClash",
              "DeleteEdit",
              "EditDelete",
              "Failed"
            ]
          },
          "detail": {
            "type": "string"
          },
          "localCopy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "detail",
          "localCopy",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "PendingItem": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "lastError": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "since",
          "lastError"
        ],
        "additionalProperties": false
      },
      "NotSignedInEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "NotSignedIn"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "InvalidFolderEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidFolder"
            ]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "path",
          "reason"
        ],
        "additionalProperties": false
      },
      "LinkInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rootPath": {
            "type": "string"
          },
          "linkedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "rootPath",
          "linkedAt"
        ],
        "additionalProperties": false
      },
      "ServerUnreachableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ServerUnreachable"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "reason"
        ],
        "additionalProperties": false
      },
      "SignInFailedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "SignInFailed"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "reason"
        ],
        "additionalProperties": false
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "serverUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "email"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "serverUrl",
          "user"
        ],
        "additionalProperties": false
      },
      "SyncStatusEncoded": {
        "type": "string",
        "contentMediaType": "application/json"
      },
      "SyncStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "signed-out",
              "unlinked",
              "paused",
              "blocked",
              "offline",
              "syncing",
              "attention",
              "up-to-date"
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "serverUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "linkedFolder": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "pendingCount": {
            "type": "integer"
          },
          "issueCount": {
            "type": "integer"
          },
          "lastSyncedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "state",
          "detail",
          "user",
          "serverUrl",
          "linkedFolder",
          "pendingCount",
          "issueCount",
          "lastSyncedAt"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "status"
    },
    {
      "name": "session"
    },
    {
      "name": "link"
    },
    {
      "name": "sync"
    }
  ]
}
