                      "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "ServerUnreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerUnreachableEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "serverUrl": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "serverUrl",
                  "token"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "tags": [
          "session"
        ],
        "operationId": "session.signOut",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    },
