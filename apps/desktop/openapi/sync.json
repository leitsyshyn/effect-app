                  "$ref": "#/components/schemas/InvalidFolderEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          },
          "409": {
            "description": "NotSignedIn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedInEncoded"
                }
              }
