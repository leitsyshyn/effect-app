          },
          "500": {
            "description": "InternalServerError"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "move": {
                    "$ref": "#/components/schemas/MoveTarget"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "expectedRevision"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
