              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                },
                "x-effect-stream": {
                  "encoding": "uint8array"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "NodeNotFound",
