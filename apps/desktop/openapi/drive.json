                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ParentNotFolderEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/NameConflictEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/InvalidMoveEncoded"
