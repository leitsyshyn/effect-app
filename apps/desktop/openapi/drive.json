              "format": "uuid"
            },
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "DriveNode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriveNode"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
